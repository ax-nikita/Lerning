{
  "name": "lerning/day2",
  "description": "Learning project for Composer and PSR-4",
  "license": "proprietary",
  "version": "1.0.0",

  "require": {
    "php": "^8.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.4"
    },
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "require-dev": {
    "phpstan/phpstan": "2.2",
    "laravel/pint": "^1.30",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse src --level=8",
    "lint": [
      "@php -l src/Ticket/Ticket.php",
      "@php -l src/Ticket/TicketPriority.php",
      "@php -l src/Ticket/TicketStatus.php"
    ],
    "style": "@php vendor/bin/pint"
  }
}
